# Lumina Backend Environment Configuration
PORT=3000
NODE_ENV=development

# Allowed Origins for CORS (comma-separated). In production, set to your domain (e.g. https://lumina.iiits.ac.in)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:3000

# Rate Limiting Configuration (requests per window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
