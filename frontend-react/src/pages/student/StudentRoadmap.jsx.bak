import { useState, useEffect } from 'react';
import toast from 'react-hot-toast';

import AppShell from '../../components/common/AppShell';
import PageHeader from '../../components/common/PageHeader';
import LoadingSpinner from '../../components/ui/LoadingSpinner';

import { useAuth } from '../../context/AuthContext';
import { coursesService } from '../../services/courses.service';

import styles from './StudentRoadmap.module.css';

export default function StudentRoadmap() {
  const { user } = useAuth();
  const studentId = user?.User_ID || 'S2024001';

  const [loading, setLoading] = useState(true);
  const [prereqWarning, setPrereqWarning] = useState('');

  // Degree Progress Audit State
  const [degreeStats, setDegreeStats] = useState({
    completedCredits: 68,
    totalRequiredCredits: 140,
    coreCompleted: 48,
    coreTotal: 60,
    peCompleted: 12,
    peTotal: 24,
    ieCompleted: 6,
    ieTotal: 12,
    seedCompleted: 2,
    seedTotal: 4,
  });

  // Past Semesters History
  const [pastSemesters] = useState([
    {
      sem: 1,
      title: 'Semester 1',
      date: 'Autumn 2024',
      totalCredits: 22,
      courses: [
        { id: 'CS101', name: 'Intro to Computer Science', credits: 4, grade: 'A' },
        { id: 'MA101', name: 'Calculus & Linear Algebra', credits: 4, grade: 'A-' },
        { id: 'PH101', name: 'Engineering Physics', credits: 4, grade: 'B+' },
        { id: 'EE101', name: 'Basic Electrical Engg', credits: 4, grade: 'A' },
        { id: 'HS101', name: 'Professional Communication', credits: 3, grade: 'A' },
        { id: 'SEED1', name: 'Environmental Science', credits: 3, grade: 'Pass' },
      ],
    },
    {
      sem: 2,
      title: 'Semester 2',
      date: 'Spring 2025',
      totalCredits: 23,
      courses: [
        { id: 'CS102', name: 'Data Structures & Algorithms', credits: 4, grade: 'A' },
        { id: 'MA102', name: 'Differential Equations', credits: 4, grade: 'B+' },
        { id: 'EC101', name: 'Digital Logic Design', credits: 4, grade: 'A' },
        { id: 'CS201', name: 'Discrete Mathematics', credits: 4, grade: 'A' },
        { id: 'IE101', name: 'Intro to Economics', credits: 4, grade: 'A-' },
        { id: 'SEED2', name: 'Ethics & Values', credits: 3, grade: 'Pass' },
      ],
    },
    {
      sem: 3,
      title: 'Semester 3',
      date: 'Autumn 2025',
      totalCredits: 23,
      courses: [
        { id: 'CS202', name: 'Object Oriented Programming', credits: 4, grade: 'A' },
        { id: 'CS203', name: 'Computer Organization & Arch', credits: 4, grade: 'A-' },
        { id: 'MA201', name: 'Probability & Statistics', credits: 4, grade: 'A' },
        { id: 'PE201', name: 'Web Development Frameworks', credits: 4, grade: 'A' },
        { id: 'IE201', name: 'Principles of Management', credits: 4, grade: 'B+' },
        { id: 'SEED3', name: 'Social Innovation & Design', credits: 3, grade: 'Pass' },
      ],
    },
  ]);

  // Future Semesters Roadmap Planner
  const [futureSemesters, setFutureSemesters] = useState({
    4: {
      label: 'Semester 4 (Current)',
      date: 'Spring 2026',
      totalCredits: 15,
      isCurrent: true,
      courses: [
        { id: 'CS301', name: 'Database Management Systems', credits: 4, type: 'Core', prereq: 'CS102' },
        { id: 'CS302', name: 'Operating Systems', credits: 4, type: 'Core', prereq: 'CS102' },
        { id: 'IC241', name: 'Computer Networks', credits: 4, type: 'Core', prereq: 'None' },
        { id: 'CS304', name: 'Formal Languages & Automata', credits: 3, type: 'Core', prereq: 'CS201' },
      ],
    },
    5: {
      label: 'Semester 5',
      date: 'Autumn 2026',
      totalCredits: 18,
      courses: [
        { id: 'CS401', name: 'Software Engineering', credits: 4, type: 'Core', prereq: 'CS301' },
        { id: 'CS402', name: 'Compiler Design', credits: 4, type: 'Core', prereq: 'CS304' },
        { id: 'PE301', name: 'Machine Learning', credits: 4, type: 'PE', prereq: 'MA201' },
        { id: 'IE301', name: 'Financial Accounting', credits: 3, type: 'IE', prereq: 'None' },
        { id: 'SEED4', name: 'Community Outreach', credits: 3, type: 'SEED', prereq: 'None' },
      ],
    },
    6: {
      label: 'Semester 6',
      date: 'Spring 2027',
      totalCredits: 18,
      courses: [
        { id: 'CS403', name: 'Design & Analysis of Algorithms', credits: 4, type: 'Core', prereq: 'CS102' },
        { id: 'PE401', name: 'Cloud Computing & DevOps', credits: 4, type: 'PE', prereq: 'CS302' },
        { id: 'PE402', name: 'Artificial Intelligence', credits: 4, type: 'PE', prereq: 'PE301' },
        { id: 'IE401', name: 'Cyber Law & Intellectual Property', credits: 3, type: 'IE', prereq: 'None' },
        { id: 'SEED5', name: 'Industry Internship I', credits: 3, type: 'SEED', prereq: 'None' },
      ],
    },
    7: {
      label: 'Semester 7',
      date: 'Autumn 2027',
      totalCredits: 18,
      courses: [
        { id: 'CS501', name: 'Distributed Systems', credits: 4, type: 'Core', prereq: 'CS302' },
        { id: 'PE501', name: 'Deep Learning & Neural Nets', credits: 4, type: 'PE', prereq: 'PE402' },
        { id: 'PE502', name: 'Information Security', credits: 4, type: 'PE', prereq: 'IC241' },
        { id: 'PROJ1', name: 'B.Tech Capstone Project I', credits: 6, type: 'Core', prereq: 'CS401' },
      ],
    },
    8: {
      label: 'Semester 8',
      date: 'Spring 2028',
      totalCredits: 18,
      courses: [
        { id: 'PROJ2', name: 'B.Tech Capstone Project II', credits: 12, type: 'Core', prereq: 'PROJ1' },
        { id: 'PE601', name: 'Big Data Analytics', credits: 4, type: 'PE', prereq: 'CS301' },
        { id: 'SEED6', name: 'Leadership & Entrepreneurship', credits: 2, type: 'SEED', prereq: 'None' },
      ],
    },
  });

  useEffect(() => {
    async function loadReqs() {
      setLoading(true);
      try {
        const reqs = await coursesService.getDegreeRequirements();
        if (reqs) {
          setDegreeStats((prev) => ({ ...prev, ...reqs }));
        }
      } catch (err) {
        // Keep default initialized stats
      } finally {
        setLoading(false);
      }
    }
    loadReqs();
  }, []);

  function downloadRoadmapPDF() {
    const printableWindow = window.open('', '_blank');
    if (!printableWindow) {
      toast.error('Please allow popups to download the Academic Roadmap PDF.');
      return;
    }

    const htmlContent = `
      <!DOCTYPE html>
      <html>
      <head>
        <title>Academic Roadmap - ${studentId}</title>
        <style>
          body { font-family: Arial, sans-serif; padding: 30px; color: #0f172a; background: #fff; }
          h1 { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
          p { font-size: 13px; color: #64748b; margin-bottom: 24px; }
          .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
          .card { border: 1px solid #cbd5e1; border-radius: 8px; padding: 14px; background: #f8fafc; }
          .card-title { font-weight: 700; font-size: 14px; color: #071932; margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; }
          .row { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
          .cr { font-weight: 700; color: #0284c7; }
        </style>
      </head>
      <body>
        <h1>Lumina Academic Systems - Student Degree Roadmap</h1>
        <p>Student ID: ${studentId} &bull; Program: B.Tech Computer Science & Engineering &bull; Generated: ${new Date().toLocaleDateString()}</p>
        
        <div class="grid">
          ${Object.values(futureSemesters)
            .map(
              (sem) => `
            <div class="card">
              <div class="card-title">${sem.label} (${sem.date})</div>
              ${sem.courses
                .map(
                  (c) => `
                <div class="row">
                  <span>${c.id}: ${c.name} (${c.type})</span>
                  <span class="cr">${c.credits} CR</span>
                </div>
              `
                )
                .join('')}
              <div style="margin-top: 8px; font-size: 11px; font-weight: 700; text-align: right;">Total: ${sem.totalCredits} Credits</div>
            </div>
          `
            )
            .join('')}
        </div>
        <script>window.onload = function() { window.print(); };</script>
      </body>
      </html>
    `;

    printableWindow.document.write(htmlContent);
    printableWindow.document.close();
  }

  return (
    <AppShell>
      <div className={styles.container}>
        <PageHeader
          title="Academic Roadmap & Degree Audit"
          subtitle="4-Year Curriculum Flow &bull; Plan future semesters, verify prerequisites, and track degree completion."
          actions={
            <button type="button" className="btn-primary" onClick={downloadRoadmapPDF}>
              📄 Download / Print Roadmap PDF
            </button>
          }
        />

        {loading ? (
          <LoadingSpinner message="Loading academic roadmap planner..." />
        ) : (
          <>
            {/* Degree Progress Audit Card */}
            <div className={styles.degreeAuditCard}>
              <div className={styles.auditHeader}>
                <div>
                  <h3 style={{ fontSize: '1.1rem', fontWeight: 800, color: '#0f172a' }}>
                    B.Tech Computer Science & Engineering - Degree Progress
                  </h3>
                  <span style={{ fontSize: '0.85rem', color: '#64748b' }}>
                    Curriculum Batch 2024-2028 &bull; Total Target: 140 Credits
                  </span>
                </div>
                <div>
                  <span className="badge badge-approved" style={{ fontSize: '0.9rem', padding: '6px 14px' }}>
                    {degreeStats.completedCredits} / {degreeStats.totalRequiredCredits} Credits Completed (48.5%)
                  </span>
                </div>
              </div>

              <div className={styles.progressGrid}>
                <div className={styles.progressBox}>
                  <div className={styles.progressLabel}>Program Core</div>
                  <div style={{ fontWeight: 800, fontSize: '1.2rem', color: '#0f172a' }}>
                    {degreeStats.coreCompleted} / {degreeStats.coreTotal} CR
                  </div>
                  <div className={styles.progressBarTrack}>
                    <div
                      className={styles.progressBarFill}
                      style={{ width: `${(degreeStats.coreCompleted / degreeStats.coreTotal) * 100}%` }}
                    />
                  </div>
                </div>

                <div className={styles.progressBox}>
                  <div className={styles.progressLabel}>Program Electives</div>
                  <div style={{ fontWeight: 800, fontSize: '1.2rem', color: '#0f172a' }}>
                    {degreeStats.peCompleted} / {degreeStats.peTotal} CR
                  </div>
                  <div className={styles.progressBarTrack}>
                    <div
                      className={styles.progressBarFill}
                      style={{
                        width: `${(degreeStats.peCompleted / degreeStats.peTotal) * 100}%`,
                        background: '#10b981',
                      }}
                    />
                  </div>
                </div>

                <div className={styles.progressBox}>
                  <div className={styles.progressLabel}>Open / Institute Electives</div>
                  <div style={{ fontWeight: 800, fontSize: '1.2rem', color: '#0f172a' }}>
                    {degreeStats.ieCompleted} / {degreeStats.ieTotal} CR
                  </div>
                  <div className={styles.progressBarTrack}>
                    <div
                      className={styles.progressBarFill}
                      style={{
                        width: `${(degreeStats.ieCompleted / degreeStats.ieTotal) * 100}%`,
                        background: '#f59e0b',
                      }}
                    />
                  </div>
                </div>

                <div className={styles.progressBox}>
                  <div className={styles.progressLabel}>SEED & Skill Courses</div>
                  <div style={{ fontWeight: 800, fontSize: '1.2rem', color: '#0f172a' }}>
                    {degreeStats.seedCompleted} / {degreeStats.seedTotal} CR
                  </div>
                  <div className={styles.progressBarTrack}>
                    <div
                      className={styles.progressBarFill}
                      style={{
                        width: `${(degreeStats.seedCompleted / degreeStats.seedTotal) * 100}%`,
                        background: '#8b5cf6',
                      }}
                    />
                  </div>
                </div>
              </div>
            </div>

            {/* Prerequisite Alert Warning */}
            {prereqWarning && (
              <div className={styles.warningBox}>
                <span>⚠ Prerequisite Alert:</span>
                <span>{prereqWarning}</span>
              </div>
            )}

            {/* Completed Semesters History Section */}
            <div>
              <h3 style={{ fontSize: '1.05rem', fontWeight: 700, color: '#0f172a', marginBottom: '14px' }}>
                Completed Terms Transcript History (Semesters 1 - 3)
              </h3>

              <div className={styles.roadmapGrid}>
                {pastSemesters.map((sem) => (
                  <div key={sem.sem} className={styles.semCard}>
                    <div className={`${styles.semHeader} ${styles.semHeaderDark}`}>
                      <span className={styles.semTitle}>{sem.title}</span>
                      <span style={{ fontSize: '0.78rem', color: 'rgba(255,255,255,0.7)' }}>{sem.date}</span>
                    </div>

                    <div className={styles.semBody}>
                      {sem.courses.map((c) => (
                        <div key={c.id} className={styles.courseRow}>
                          <div>
                            <strong>{c.id}</strong>: {c.name}
                          </div>
                          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                            <span style={{ fontWeight: 700, color: '#10b981' }}>{c.grade}</span>
                            <span style={{ color: '#94a3b8', fontWeight: 600 }}>{c.credits} CR</span>
                          </div>
                        </div>
                      ))}
                    </div>

                    <div className={styles.semFooter}>
                      <span style={{ color: '#64748b' }}>TOTAL CREDITS</span>
                      <span style={{ color: '#0f172a' }}>{sem.totalCredits} Credits</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Future Semesters Plan Section */}
            <div>
              <h3 style={{ fontSize: '1.05rem', fontWeight: 700, color: '#0f172a', marginBottom: '14px' }}>
                Future Academic Flow & Term Roadmap (Semesters 4 - 8)
              </h3>

              <div className={styles.roadmapGrid}>
                {Object.entries(futureSemesters).map(([semNum, sem]) => (
                  <div key={semNum} className={styles.semCard}>
                    <div className={styles.semHeader}>
                      <span className={styles.semTitle}>{sem.label}</span>
                      <span style={{ fontSize: '0.78rem', color: '#64748b' }}>{sem.date}</span>
                    </div>

                    <div className={styles.semBody}>
                      {sem.courses.map((c) => {
                        const tagClass =
                          c.type === 'Core'
                            ? styles.tagCore
                            : c.type === 'PE'
                            ? styles.tagPE
                            : c.type === 'IE'
                            ? styles.tagIE
                            : styles.tagSEED;

                        return (
                          <div key={c.id} className={styles.courseRow}>
                            <div>
                              <strong>{c.id}</strong>: {c.name}
                              <span className={`${styles.typeBadge} ${tagClass}`}>{c.type}</span>
                            </div>
                            <span style={{ fontWeight: 700, color: '#64748b' }}>{c.credits} CR</span>
                          </div>
                        );
                      })}
                    </div>

                    <div className={styles.semFooter}>
                      <span style={{ color: '#64748b' }}>TOTAL CREDITS</span>
                      <span style={{ color: '#0284c7' }}>{sem.totalCredits} Credits</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </>
        )}
      </div>
    </AppShell>
  );
}
