    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "User_ID": {
                    "type": "string",
                    "example": "S2024001"
                  },
                  "Password": {
                    "type": "string",
                    "example": "password123"
                  }
                },
                "required": [
                  "User_ID",
                  "Password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login successful. Returns session object."
          },
          "401": {
            "description": "Invalid credentials."
          }
        },
        "summary": "Authenticate a user",
        "tags": [
          "Auth"
        ]
      }
    },
